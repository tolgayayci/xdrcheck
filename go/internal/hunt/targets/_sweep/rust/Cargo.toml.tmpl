[package]
name = "sweep"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
stellar-xdr = { version = "=@VERSION@", default-features = false, features = ["std", "serde", "serde_json", "base64"] }
serde = "1"
serde_json = { version = "1", features = ["unbounded_depth"] }
sha2 = "0.10"
hex = "0.4"
zstd = "0.13"
base64 = "0.22"

[profile.release]
opt-level = 2
debug = false

[workspace]
