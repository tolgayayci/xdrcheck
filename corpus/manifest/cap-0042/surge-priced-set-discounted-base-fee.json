{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0042/surge-priced-set-discounted-base-fee",
  "title": "Surge-priced transaction set: a discounted base fee in the component and one bid left out",
  "kind": "ledger",
  "caps": [
    42
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "surge-pricing",
    "discounted-base-fee",
    "tx-left-out-of-ledger",
    "fee-charged-below-bid",
    "controlled-apply-order"
  ],
  "why": "When more operations are queued than a ledger admits, stellar-core leaves the lowest bids out and charges every included transaction the lowest included per-operation bid, which it records as the component's base fee. Readers that compute fees from the header's base fee or from the bid, or that expect every submitted transaction in the next ledger, get the fees and the ledger contents wrong.",
  "fields": {
    "validated": [
      "VF-03"
    ]
  },
