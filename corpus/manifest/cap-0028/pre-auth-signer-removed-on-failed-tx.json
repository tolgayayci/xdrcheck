{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0028/pre-auth-signer-removed-on-failed-tx",
  "title": "Pre-authorised transaction fails, and its pre-auth-tx signer is removed all the same",
  "kind": "ledger",
  "caps": [
    28
  ],
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "pre-auth-tx-signer",
    "signer-removed-at-transaction-level",
    "failed-transaction-with-state-change",
    "transaction-without-signatures"
  ],
  "why": "A pre-auth-tx signer is used up when its transaction is applied, whatever the outcome: here the payment fails, yet the signer disappears from the account in the transaction-level changes, before any operation runs. Readers that take signer changes only from operations, or skip failed transactions, keep a signer that no longer exists.",
