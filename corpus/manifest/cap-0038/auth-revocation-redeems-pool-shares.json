{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0038/auth-revocation-redeems-pool-shares",
  "title": "Authorization revocation redeems pool shares into two claimable balances (POOL_REVOKE_OP_ID)",
  "kind": "ledger",
  "caps": [
    38
  ],
  "protocol": {
    "introduced": 18
  },
  "synthetic": false,
