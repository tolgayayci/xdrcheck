{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0038/pool-issuers-order-by-bytes-not-strkey-local-twins",
  "title": "Pool-share ChangeTrust whose assets are in raw-key order, the reverse of their strkey order, on both passphrases",
  "kind": "ledger",
  "caps": [
    38
  ],
  "protocol": {
    "introduced": 18
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "liquidity-pool-share-trustline",
    "issuers-sort-differently-by-strkey-and-bytes",
    "pool-created"
  ],
  "why": "stellar-core orders a pool's two assets by their XDR bytes, so of two same-code assets the one whose issuer key is lower comes first even when its strkey sorts later. SDKs that validate the order by comparing strkeys reject a valid operation, and with it the transaction or the whole ledger.",
  "fields": {
    "validated": [
      "VF-32"
    ]
  },
