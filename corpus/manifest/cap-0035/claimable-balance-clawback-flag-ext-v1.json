{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0035/claimable-balance-clawback-flag-ext-v1",
  "title": "Claimable balance with ext.v1 flags = 1 (clawback enabled), clawed back in the same transaction",
  "kind": "ledger",
  "caps": [
    35
  ],
  "protocol": {
    "introduced": 17
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "create-claimable-balance",
    "claimable-balance-ext-v1",
    "claimable-balance-clawback-enabled",
    "clawback-claimable-balance"
  ],
  "why": "A balance made from a clawback-enabled trustline inherits CLAIMABLE_BALANCE_CLAWBACK_ENABLED_FLAG in an ext.v1 the original entry layout does not have, and the issuer can then remove it with ClawbackClaimableBalance. Readers that ignore the extension, or treat every removed balance as claimed by its claimant, credit the wrong account.",
