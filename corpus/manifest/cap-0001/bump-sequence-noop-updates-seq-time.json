{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0001/bump-sequence-noop-updates-seq-time",
  "title": "BumpSequence below the current sequence number changes only seqLedger and seqTime",
  "kind": "ledger",
  "caps": [
    1,
    21
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "bump-sequence",
    "bump-sequence-noop",
    "seq-ledger-seq-time",
    "operation-source-not-transaction-source"
  ],
  "why": "From Protocol 19 a BumpSequence whose target is lower than the sequence number still succeeds and updates the account's seqLedger and seqTime extension (here adding the extension), while the sequence number stays. Readers that treat a successful bump as a sequence change, or ignore the change, misreport the account.",
