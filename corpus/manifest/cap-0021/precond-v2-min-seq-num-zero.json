  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0021/precond-v2-min-seq-num-zero",
  "title": "PRECOND_V2 whose minSeqNum is present and 0, with unbounded time bounds",
  "kind": "ledger",
  "caps": [
    21
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "precond-v2",
    "min-seq-num-zero",
    "time-bounds-unbounded"
  ],
  "why": "A minSeqNum of 0 is present and lets the transaction apply over any source sequence number below its own; an absent one requires exactly seqNum - 1. Readers and SDKs that test the 64-bit value for truthiness read 0 as absent: they report no minimum-sequence condition, and a transaction rebuilt from the parsed object loses the field and becomes another transaction with another hash.",
