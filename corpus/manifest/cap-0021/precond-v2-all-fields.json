{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0021/precond-v2-all-fields",
  "title": "PRECOND_V2 with ledger bounds, minSeqNum, minSeqAge, minSeqLedgerGap and two extra signers",
  "kind": "ledger",
  "caps": [
    21
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "precond-v2",
    "ledger-bounds-max-zero",
    "min-seq-num-gap",
    "min-seq-age",
    "min-seq-ledger-gap",
    "extra-signers"
  ],
  "why": "Every PRECOND_V2 field except the time bounds is set: an unbounded maxLedger of 0, a minimum sequence number that lets the sequence number skip one value, a minimum age and gap, and an ed25519 and a signed-payload extra signer. Readers that model only time bounds, or that assume sequence numbers grow by exactly one, lose the preconditions or flag a gap.",
