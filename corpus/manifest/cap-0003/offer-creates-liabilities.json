{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0003/offer-creates-liabilities",
  "title": "ManageSellOffers creating selling and buying liabilities in the account and its trustlines",
  "kind": "ledger",
  "caps": [
    3
  ],
  "protocol": {
    "introduced": 10
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "manage-sell-offer",
    "liabilities",
    "account-ext-v1-liabilities",
    "trustline-ext-v1-liabilities",
    "native-offer"
  ],
  "why": "Since CAP-0003 every open offer reserves what it could sell and buy as liabilities: native ones in the account's ext.v1, issued ones in the trustlines' ext.v1. Readers that compute available balance as balance minus reserve, ignoring liabilities, overstate what the account can spend.",
