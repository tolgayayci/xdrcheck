{
  "schema": "xcc.manifest.entry/v1",
  "id": "protocol-29/path-payment-pool-hops-beyond-crossing-limit",
  "title": "Path payment crossing 1000 offers and then a pool, valid only from Protocol 29",
  "kind": "ledger",
  "caps": [],
  "caps_note": "Protocol 29 shipped no CAP; stellar-core commit 12077a23 exempts pool hops from the offer-crossing limit from that protocol.",
  "protocol": {
    "introduced": 29
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "path-payment-strict-send",
    "claim-atoms-1001",
    "offers-crossed-1000",
    "pool-hop",
    "pool-hop-exempt-from-crossing-limit"
  ],
  "why": "Until Protocol 29 a pool hop counted against the 1000 offers one operation may cross, so a payment that crossed 1000 offers could not continue through a pool. From Protocol 29 it can, and the result holds 1001 claim atoms; readers with a 1000-atom cap, or that validate against the old limit, reject or truncate a valid result.",
  "fields": {
    "validated": [
      "VF-25"
    ]
  },
