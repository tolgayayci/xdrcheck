{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.no-account",
  "title": "Transaction failed at apply time with txNO_ACCOUNT after an earlier transaction merged its source away",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: the apply-time transaction checks predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "tx-no-account",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger",
    "account-merge"
  ],
  "why": "MA's transaction was valid when the set was built; MB's transaction, applied first, merges MA into MB. MA's fee was already taken, so the merged balance is 999,999,900 stroops, and MA's own transaction then finds no source account. Readers that assume a failed transaction's source still exists, or look up its account to attribute the fee, fail here.",
