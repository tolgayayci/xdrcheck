  "id": "classic/amount-above-2-pow-53-stroops",
  "title": "Issued-asset payment of 2^53 + 1 stroops leaving both balances at 2^53 + 1",
  "kind": "ledger",
  "caps": [],
  "caps_note": "Amounts are int64 in every protocol version; the float64 limit is a reader problem, not a protocol change.",
  "protocol": {
    "introduced": 1
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "amount-above-float64-precision",
    "issued-asset-payment",
    "trustline-balance"
  ],
  "why": "9007199254740993 is the smallest positive integer a float64 cannot hold, so a reader that parses amounts or balances as JSON numbers or doubles stores 9007199254740992 for the payment and both trustline balances.",
