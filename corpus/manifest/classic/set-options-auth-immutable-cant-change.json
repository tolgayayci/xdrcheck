  "id": "classic/set-options-auth-immutable-cant-change",
  "title": "SetOptions setting AUTH_REQUIRED on an AUTH_IMMUTABLE account fails with SET_OPTIONS_CANT_CHANGE",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: account authorization flags predate the CAP process.",
  "protocol": {
