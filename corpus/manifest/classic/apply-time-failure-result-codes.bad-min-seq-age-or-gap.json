{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.bad-min-seq-age-or-gap",
  "title": "Transaction failed at apply time with txBAD_MIN_SEQ_AGE_OR_GAP after an earlier no-op bump moved its source's seqLedger",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP introduced the result code alone; min_seq_ledger_gap is CAP-0021's. The shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "tx-bad-min-seq-age-or-gap",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger",
    "preconditions-v2"
  ],
  "why": "GA's transaction asks for min_seq_ledger_gap 1 (CAP-0021). The transaction applied first bumps GA's sequence number to 1, below its current one: the number does not change, but GA's seqLedger becomes this ledger, so GA's transaction now comes too early. Readers that evaluate preconditions from the envelope and the previous ledger's state call this transaction valid.",
