{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/create-account-funded-from-root",
  "title": "CreateAccount operations funded by the network root account, whose key differs per passphrase",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: the network root account is part of stellar-core's genesis, not of a protocol change.",
  "protocol": {
    "introduced": 1
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "create-account",
    "network-root-account",
    "passphrase-dependent-source",
    "multiple-operations"
  ],
  "why": "The root account's key is derived from the network ID, so the same funding transaction has a different source on each passphrase while every created account is the same. Readers or fixtures that hard-code one network's root, or derive it from the wrong passphrase, attribute the funding to the wrong account.",
