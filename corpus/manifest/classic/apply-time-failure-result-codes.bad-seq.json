{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.bad-seq",
  "title": "Transaction failed at apply time with txBAD_SEQ after an earlier transaction bumped its source's sequence",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: txBAD_SEQ and the apply-time sequence check predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "tx-bad-seq",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger"
  ],
  "why": "A transaction that was valid when the set was built can still fail with txBAD_SEQ when an earlier transaction of the same ledger moved its source's sequence number. It pays its fee, consumes no sequence number and has no operation results; readers that assume failed transactions never reach a ledger, or that read the sequence number from the envelope, get it wrong.",
