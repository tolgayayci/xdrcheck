{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.bad-auth-extra",
  "title": "Transaction failed at apply time with txBAD_AUTH_EXTRA after an earlier transaction made one of its signatures unnecessary",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: the apply-time transaction checks predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "tx-bad-auth-extra",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger",
    "signers"
  ],
  "why": "XA's transaction carries XA's and Y's signatures for an operation whose source is Y. The transaction applied first adds XA as a signer of Y, so when XA's transaction is applied XA's signature alone meets Y's threshold and Y's goes unused. Signature checks are repeated while applying; readers that treat txBAD_AUTH_EXTRA as a submission-only error cannot place it in a ledger.",
