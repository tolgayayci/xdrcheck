{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/manage-offer-id-int64-max-not-found",
  "title": "ManageSellOffer deleting offer ID INT64_MAX fails with NOT_FOUND",
  "kind": "ledger",
  "caps": [],
  "caps_note": "Offer IDs are int64 and NOT_FOUND exists in every protocol version; no CAP changed them.",
  "protocol": {
    "introduced": 15
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "manage-sell-offer",
    "offer-id-int64-max",
    "failed-transaction",
    "offer-not-found"
  ],
  "why": "An offer ID of INT64_MAX passes every stateless check and fails only at apply. Readers that hold offer IDs as float64 round it to another ID, and readers that act on the operation rather than the result delete an offer that never existed.",
