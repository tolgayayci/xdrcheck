{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.bad-auth",
  "title": "Transaction failed at apply time with txBAD_AUTH after an earlier transaction zeroed its master key",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: txBAD_AUTH and the apply-time signature check predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "tx-bad-auth",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger"
  ],
  "why": "Signatures are checked again when a transaction is applied, against the signers as an earlier transaction of the same ledger left them. A transaction that failed with txBAD_AUTH at apply time has consumed its sequence number and paid its fee but has no operation results; readers that treat txBAD_AUTH as a submission-only code, or expect a sequence number to stay, misreport it.",
