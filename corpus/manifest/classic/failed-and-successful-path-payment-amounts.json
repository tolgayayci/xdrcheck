{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/failed-and-successful-path-payment-amounts",
  "title": "A failed and a successful path payment with identical envelope amounts in one ledger",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: path payments and their result codes predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 1
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "path-payment-strict-receive",
    "failed-transaction",
    "too-few-offers",
    "controlled-apply-order",
    "claim-atoms"
  ],
  "why": "Two path payments with the same send_max and dest_amount meet one offer: the first consumes it and moves value, the second fails with TOO_FEW_OFFERS and moves nothing. Readers that take amounts from the envelope instead of the results and ledger changes report a payment that never happened.",
  "fields": {
    "validated": [
      "VF-04",
      "VF-25"
    ]
  },
