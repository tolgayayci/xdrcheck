{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/apply-time-failure-result-codes.op-bad-auth",
  "title": "Operation failed at apply time with opBAD_AUTH after an earlier transaction zeroed its source's master key",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: the apply-time transaction checks predate the CAP process; the shape needs two transactions of one ledger applied in a chosen order.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "failed-transaction",
    "op-bad-auth",
    "apply-time-failure",
    "controlled-apply-order",
    "two-transactions-one-ledger",
    "operation-source"
  ],
  "why": "OY's transaction has an operation whose source is OX, signed by OX's master key. The transaction applied first sets OX's master weight to 0, so that operation's signature no longer counts and the transaction fails with txFAILED and opBAD_AUTH, an OperationResult arm with no operation-specific result. Readers that expect every failed operation to carry its operation type's result trip on it.",
