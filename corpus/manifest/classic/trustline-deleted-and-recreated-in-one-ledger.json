{
  "schema": "xcc.manifest.entry/v1",
  "id": "classic/trustline-deleted-and-recreated-in-one-ledger",
  "title": "A trustline removed and created again by two transactions in one ledger",
  "kind": "ledger",
  "caps": [],
  "caps_note": "ChangeTrust with limit 0 removing an empty trustline predates the CAP process; the pattern is a ledger-level ordering of two ordinary operations, not a protocol change.",
  "protocol": {
    "introduced": 1
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "trustline-removed",
    "trustline-created",
    "same-ledger-churn"
  ],
  "why": "Two transactions in one ledger change the same trustline: the first removes it (limit 0), the second creates it again. A reader that aggregates a ledger's changes per trustline, or keys a balance row by account and asset without ordering, keeps a stale row or loses the re-created trustline.",
  "fields": {
    "validated": [
      "VF-32"
    ]
  },
