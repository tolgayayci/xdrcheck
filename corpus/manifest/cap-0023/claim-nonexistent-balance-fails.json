{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0023/claim-nonexistent-balance-fails",
  "title": "Claim of a balance ID that does not exist fails at apply with DOES_NOT_EXIST",
  "kind": "ledger",
  "caps": [
    23
  ],
  "protocol": {
    "introduced": 15
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "claim-claimable-balance",
    "failed-transaction",
    "claim-does-not-exist"
  ],
  "why": "stellar-core checks a claimed balance ID only when it applies the operation, so a claim of a balance that never existed reaches the ledger as a failed transaction. Readers that trust the ID in a failed operation look up, or even create, a balance that is not there.",
  "fields": {
    "passed_through": [
      "VF-36b"
    ]
  },
