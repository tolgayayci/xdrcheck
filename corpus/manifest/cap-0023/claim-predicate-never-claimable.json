{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0023/claim-predicate-never-claimable",
  "title": "Claim of a balance whose predicate is NOT(UNCONDITIONAL) fails with CANNOT_CLAIM",
  "kind": "ledger",
  "caps": [
    23
  ],
  "protocol": {
    "introduced": 15
  },
  "synthetic": false,
  "validity": "valid",
  "shapes": [
    "claim-claimable-balance",
    "claim-predicate-not-unconditional",
    "failed-transaction",
    "claim-cannot-claim"
  ],
  "why": "NOT(UNCONDITIONAL) is a valid predicate that is never true, so the named claimant can never take the balance. A reader that records a claim from the operation instead of the result, or treats the balance as claimable, credits funds that never moved.",
