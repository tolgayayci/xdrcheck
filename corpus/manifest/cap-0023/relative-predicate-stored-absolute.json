  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0023/relative-predicate-stored-absolute",
  "title": "BEFORE_RELATIVE_TIME(INT64_MAX) in the operation, BEFORE_ABSOLUTE_TIME(INT64_MAX) in the ledger entry",
  "kind": "ledger",
  "caps": [
