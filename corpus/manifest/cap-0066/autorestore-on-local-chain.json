  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0066/autorestore-on-local-chain",
  "title": "InvokeHostFunction that restores an archived entry automatically: RESTORED then UPDATED",
  "kind": "ledger",
  "caps": [
    66
  ],
  "protocol": {
    "introduced": 23
  },
  "synthetic": false,
  "negative": false,
