{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0073/sac-trust-noop-existing-or-contract-address.contract-address",
  "title": "Stellar Asset Contract trust() for a contract address succeeds and creates nothing",
  "kind": "ledger",
  "caps": [
    73
  ],
  "protocol": {
    "introduced": 26
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "sac-trust",
    "no-op-contract-call",
    "contract-address-argument"
  ],
  "why": "A contract holds its Stellar Asset Contract balance in the contract's own storage, never in a trustline, so trust(C\u2026) returns at once: success, no authorization, no ledger-entry change. A reader that derives a trustline from the call's argument invents one for an address that cannot have trustlines.",
  "fields": {
    "validated": [
      "VF-43",
      "VF-46a"
    ]
  },
