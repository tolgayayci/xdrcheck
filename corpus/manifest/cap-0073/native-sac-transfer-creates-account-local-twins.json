  "id": "cap-0073/native-sac-transfer-creates-account-local-twins",
  "title": "XLM SAC transfer to a non-existent account creating it with no CreateAccount operation, on both passphrases",
  "kind": "ledger",
  "caps": [
    73
  ],
  "protocol": {
    "introduced": 26
  },
  "synthetic": false,
