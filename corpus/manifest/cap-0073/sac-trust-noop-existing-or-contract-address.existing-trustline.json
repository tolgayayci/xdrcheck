{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0073/sac-trust-noop-existing-or-contract-address.existing-trustline",
  "title": "Stellar Asset Contract trust() for an account that already has the trustline changes nothing",
  "kind": "ledger",
  "caps": [
    73
  ],
  "protocol": {
    "introduced": 26
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "sac-trust",
    "no-op-contract-call"
  ],
  "why": "trust() is idempotent: when the trustline exists it returns without requiring authorization and writes no ledger entry. A reader that turns every trust() call into a created trustline, or into an authorization change, reports a change that did not happen.",
  "fields": {
    "validated": [
      "VF-43",
      "VF-46a"
    ]
  },
