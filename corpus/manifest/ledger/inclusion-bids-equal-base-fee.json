{
  "schema": "xcc.manifest.entry/v1",
  "id": "ledger/inclusion-bids-equal-base-fee",
  "title": "Ledger whose classic and Soroban transactions each bid exactly the base fee, so every charged inclusion fee is the bid",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: the ledger is the unmodified base of the synthetic baseFee-absent entries (CAP-0042, CAP-0063); fees charged at the base fee predate the CAP process.",
  "protocol": {
    "introduced": 23
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "generalized-tx-set",
    "discounted-base-fee",
    "fee-equals-bid",
    "parallel-phase",
    "three-transactions-one-ledger",
    "controlled-apply-order"
  ],
  "why": "Every transaction here bids exactly the base fee per operation, so the transaction set's discounted base fee and each bid coincide and the charged fee equals the envelope fee. It is the reference against which the synthetic entries that leave the component base fee out are read: a reader must report the same fees for both.",
