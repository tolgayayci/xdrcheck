{
  "schema": "xcc.manifest.entry/v1",
  "id": "ledger/base-fee-upgrade",
  "title": "LEDGER_UPGRADE_BASE_FEE from 100 to 200 in a ledger whose payment is still charged 100",
  "kind": "ledger",
  "caps": [],
  "caps_note": "No CAP: base-fee upgrades predate the CAP process.",
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "ledger-upgrade-base-fee",
    "upgrades-processing",
    "header-base-fee-change",
    "fee-at-previous-base-fee"
  ],
  "why": "pubnet and testnet have never changed their base fee, so no public ledger holds LedgerUpgrade arm 2. Upgrades apply after the ledger's transactions: the header of this ledger already says 200 while its payment was charged 100, so a reader that computes fees from the header of the same ledger gets them wrong.",
