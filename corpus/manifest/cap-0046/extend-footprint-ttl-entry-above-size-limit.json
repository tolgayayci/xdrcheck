{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0046/extend-footprint-ttl-entry-above-size-limit",
  "title": "ExtendFootprintTTL of an entry larger than the lowered maximum entry size fails with RESOURCE_LIMIT_EXCEEDED",
  "kind": "ledger",
  "caps": [
    46
  ],
  "protocol": {
    "introduced": 20
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "extend-footprint-ttl-resource-limit-exceeded",
    "config-upgrade",
    "entry-size-limit",
    "declared-footprint",
    "failed-transaction"
  ],
  "why": "The entry was written under the network's 64 KiB limit; a configuration upgrade then lowered contract_data_entry_size_bytes to 2000. stellar-core checks each extended entry against the current limit while applying, so the extension fails although the declared resources were ample. Readers that treat EXTEND_FOOTPRINT_TTL_RESOURCE_LIMIT_EXCEEDED as a resource-declaration mistake misreport it.",
