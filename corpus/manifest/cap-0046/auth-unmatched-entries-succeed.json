{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0046/auth-unmatched-entries-succeed",
  "title": "SAC transfer succeeds with two unmatched address-credential entries of an uninvolved account",
  "kind": "ledger",
  "caps": [
    46
  ],
  "protocol": {
    "introduced": 20
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "unmatched-auth-entry",
    "void-signature",
    "expired-signature",
    "nested-auth-tree"
  ],
  "why": "Authorization entries are matched lazily: an entry no require_auth call matches is never authenticated, its expiration is never checked and no nonce is written. The transfer succeeds although U's entries carry a Void signature, expired at ledger 1, one of them a three-level tree. A reader that turns every address in the auth list into a participant records an account the transaction never touched.",
  "fields": {
    "validated": [
      "VF-46a",
      "VF-47"
    ],
    "passed_through": [
      "VF-48b",
      "VF-49b"
    ]
  },
