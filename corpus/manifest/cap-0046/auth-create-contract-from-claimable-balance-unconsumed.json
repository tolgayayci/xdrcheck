{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0046/auth-create-contract-from-claimable-balance-unconsumed",
  "title": "Successful transaction carrying an unconsumed source-account entry that declares create_contract from a B address",
  "kind": "ledger",
  "caps": [
    46,
    67
  ],
  "protocol": {
    "introduced": 23
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "unmatched-auth-entry",
    "source-account-credentials",
    "create-contract-host-fn",
    "claimable-balance-address"
  ],
  "why": "The authorization tree is a claim of what may be called, not what was. This entry declares creating a contract from a claimable-balance address, the call never does it, and the transaction succeeds. A reader that derives a deployment, a participant or a state change from the entry, or that cannot parse a B\u2026 address in the tree, fabricates facts or halts.",
