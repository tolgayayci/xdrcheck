{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0046/scval-map-absent-in-invocation-argument",
  "title": "InvokeHostFunction whose argument is SCV_MAP with the map absent; the host traps while applying",
  "kind": "ledger",
  "caps": [
    46
  ],
  "protocol": {
    "introduced": 20
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "scval-map-none",
    "invoke-host-function-trapped",
    "declared-footprint",
    "failed-transaction"
  ],
  "why": "SCVal's map arm is an optional SCMap, and its absent state is valid XDR that no contract can produce. stellar-core admits the transaction and the host refuses the argument while applying (INVOKE_HOST_FUNCTION_TRAPPED), so the absent map sits in a ledger's envelope. Readers that assume SCV_MAP always holds a map dereference nothing.",
