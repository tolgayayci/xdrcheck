  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0033/revoke-signer-sponsorship-null-hole",
  "title": "RevokeSponsorship of the middle signer leaves signerSponsoringIDs = [G, null, G]",
  "kind": "ledger",
  "caps": [
    33
  ],
  "protocol": {
    "introduced": 15
