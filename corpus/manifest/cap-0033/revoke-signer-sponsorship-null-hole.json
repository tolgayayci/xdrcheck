  "validity": "valid",
  "shapes": [
    "revoke-sponsorship-signer",
    "signer-sponsoring-ids-null",
    "sponsored-signer"
  ],
  "why": "signerSponsoringIDs runs parallel to the signer list and holds null for an unsponsored signer. Revoking the middle signer's sponsorship leaves a null between two sponsor IDs, which readers that compact the array, stop at the first null or assume all-or-nothing sponsorship misalign.",
