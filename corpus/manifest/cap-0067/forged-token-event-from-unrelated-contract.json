  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0067/forged-token-event-from-unrelated-contract",
  "title": "Transfer event shaped like a Stellar Asset Contract event, from a contract that is not that asset's",
  "kind": "ledger",
  "caps": [
    67
  ],
  "protocol": {
