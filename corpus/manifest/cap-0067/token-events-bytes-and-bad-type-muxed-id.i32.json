  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "custom-token-event",
    "to-muxed-id"
  ],
  "why": "A custom contract can put any value in to_muxed_id. I32(5) is none of u64, bytes or string, so a reader must treat the routing ID as non-conforming rather than read it as the number 5 or fail.",
