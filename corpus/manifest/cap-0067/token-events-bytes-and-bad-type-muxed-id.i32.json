  "id": "cap-0067/token-events-bytes-and-bad-type-muxed-id.i32",
  "title": "Custom-token transfer event whose to_muxed_id is an I32, a type CAP-0067 does not allow",
  "kind": "ledger",
  "caps": [
    67
  ],
  "protocol": {
