  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0027/account-merge-to-muxed-destination",
  "title": "AccountMerge into a muxed destination: the source account is removed, the base destination credited",
  "kind": "ledger",
  "caps": [
    27
  ],
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
