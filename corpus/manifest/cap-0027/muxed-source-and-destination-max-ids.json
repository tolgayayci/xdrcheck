{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0027/muxed-source-and-destination-max-ids",
  "title": "Payment with muxed transaction source, operation source and destination at extreme IDs",
  "kind": "ledger",
  "caps": [
    27,
    67
  ],
  "protocol": {
    "introduced": 13
  },
  "synthetic": false,
  "negative": false,
