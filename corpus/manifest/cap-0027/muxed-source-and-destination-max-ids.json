  "shapes": [
    "muxed-transaction-source",
    "muxed-operation-source",
    "muxed-destination",
    "muxed-id-above-int64",
    "muxed-id-above-float64",
    "to-muxed-id-u64"
  ],
  "why": "Muxed IDs live only in the envelope and in event data: the transaction source is muxed with 2^64 - 1, the operation source with 2^63 and the destination with 2^53 + 1, while every ledger entry change is keyed by the base G account. Readers that store the M form instead of the base account, keep IDs in signed 64-bit integers or floats, or attach one source ID to the other lose or corrupt the routing.",
