  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0071/credentials-with-nested-delegates",
  "title": "Address credentials with delegates whose own nested delegate also signs (CAP-0071)",
  "kind": "ledger",
  "caps": [
    71
  ],
  "protocol": {
