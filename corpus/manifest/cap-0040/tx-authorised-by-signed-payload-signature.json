  "id": "cap-0040/tx-authorised-by-signed-payload-signature",
  "title": "Transaction authorised only by a signed-payload signature, with a XORed hint",
  "kind": "ledger",
  "caps": [
    40
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "signed-payload-signature",
    "signature-hint-xor",
    "master-key-not-signing"
  ],
  "why": "The only signature is an ed25519 signature over the payload, not over the transaction hash, and its hint is the key hint XOR the payload hint, so it matches neither key. Readers that attribute signatures by hint or verify them against the transaction hash mislabel or reject a valid transaction.",
