{
  "schema": "xcc.manifest.entry/v1",
  "id": "cap-0040/signed-payload-signers-1-byte-and-64-byte",
  "title": "SetOptions adds signed-payload signers with a 1-byte and a 64-byte payload in one transaction",
  "kind": "ledger",
  "caps": [
    40
  ],
  "protocol": {
    "introduced": 19
  },
  "synthetic": false,
  "negative": false,
  "validity": "valid",
  "shapes": [
    "signed-payload-signer",
    "set-options-add-signer",
    "signer-key-wider-than-32-bytes",
    "payload-length-extremes"
  ],
  "why": "Signed-payload signer keys are 32 key bytes plus a 1 to 64 byte payload, so their P strkeys run from 69 to 165 characters. Readers that assume 32-byte or 56-character signer keys truncate or reject them, and the shortest and longest payloads catch off-by-one padding.",
  "fields": {
    "validated": [
      "VF-29"
    ]
  },
