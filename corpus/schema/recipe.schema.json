{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcc:schema:recipe:v1",
  "title": "Synthetic recipe",
  "description": "How a synthetic entry's bytes (or an api/strkey entry) are built. Exactly one construction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "kind",
    "construction",
    "reason"
  ],
  "properties": {
    "entry": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)+$"
    },
    "kind": {
      "enum": [
        "xdr",
        "api",
        "strkey",
        "spec"
      ]
    },
    "xdr_type": {
      "type": "string"
    },
    "construction": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "hex": {
          "description": "Literal bytes.",
          "type": "string",
          "pattern": "^([0-9a-f]{2})*$"
        },
        "json": {
          "description": "SEP-51 JSON value of xdr_type, encoded by the oracle.",
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "edit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_entry",
            "ops"
          ],
          "properties": {
            "base_entry": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)+$"
            },
            "base_variant": {
              "type": "string"
            },
            "ops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "op"
                ],
                "properties": {
                  "at": {
                    "description": "Byte offset in the base blob.",
                    "type": "integer",
                    "minimum": 0
                  },
                  "op": {
                    "enum": [
                      "replace",
                      "insert",
                      "delete",
                      "append"
                    ]
                  },
                  "hex": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{2})*$"
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "op": {
                          "enum": [
                            "replace",
                            "insert",
                            "append"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "hex"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "op": {
                          "const": "delete"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "length"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "nest": {
          "description": "Generated nesting: wrap `leaf` in `wrapper` depth times.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "leaf",
            "wrapper",
            "depth"
          ],
          "properties": {
            "leaf": {},
            "wrapper": {
              "enum": [
                "scv_vec",
                "scv_map",
                "sub_invocation"
              ]
            },
            "depth": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "api": {
          "description": "The api block of the entry (manifest-entry $defs/apiVector).",
          "type": "object"
        },
        "strkey": {
          "description": "The strkey block of the entry.",
          "type": "object"
        },
        "spec": {
          "description": "A contract-spec blob: container wasm (a header-only Wasm module with one custom section per element of sections) or xdr-stream (exactly one section, bare). A section's payload is its entries (SEP-51 JSON of SCSpecEntry, encoded by the oracle, appended with no frame), then its byte ops (as in edit) applied to the payload.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "container",
            "sections"
          ],
          "properties": {
            "container": {
              "enum": [
                "wasm",
                "xdr-stream"
              ]
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entries"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "entries": {
                    "type": "array"
                  },
                  "ops": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "at",
                        "op"
                      ],
                      "properties": {
                        "at": {
                          "description": "Byte offset in the base blob.",
                          "type": "integer",
                          "minimum": 0
                        },
                        "op": {
                          "enum": [
                            "replace",
                            "insert",
                            "delete",
                            "append"
                          ]
                        },
                        "hex": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{2})*$"
                        },
                        "length": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "op": {
                                "enum": [
                                  "replace",
                                  "insert",
                                  "append"
                                ]
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "hex"
                            ]
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "op": {
                                "const": "delete"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "length"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reason": {
      "description": "Why stellar-core cannot or would not emit these bytes.",
      "type": "string",
      "minLength": 10
    },
    "origin": {
      "description": "Where the vector comes from (a probe vector ID, an issue, a SEP vector label).",
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "xdr"
          }
        }
      },
      "then": {
        "required": [
          "xdr_type"
        ],
        "properties": {
          "construction": {
            "anyOf": [
              {
                "required": [
                  "hex"
                ]
              },
              {
                "required": [
                  "json"
                ]
              },
              {
                "required": [
                  "edit"
                ]
              },
              {
                "required": [
                  "nest"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "api"
          }
        }
      },
      "then": {
        "properties": {
          "construction": {
            "required": [
              "api"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "strkey"
          }
        }
      },
      "then": {
        "properties": {
          "construction": {
            "required": [
              "strkey"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "spec"
          }
        }
      },
      "then": {
        "properties": {
          "construction": {
            "required": [
              "spec"
            ]
          }
        }
      }
    }
  ]
}