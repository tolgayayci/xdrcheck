#!/bin/sh
# Generated by `make build` from drivers/python/src/xdrcheck-driver.in: the shared Python conformance driver, run
# in isolated mode by the interpreter of the stellar-sdk venv this directory's build installed.
dir=$(cd "$(dirname "$0")/.." && pwd)
exec "@PYTHON@" -I -X pycache_prefix="@PYCACHE@" "$dir/../src/driver.py" "$@"
